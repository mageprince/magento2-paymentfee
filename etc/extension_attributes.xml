<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Api/etc/extension_attributes.xsd">
    <!-- Filled by Plugin\AddPaymentFeeExtensionAttributes on repository get/getList -->
    <extension_attributes for="Magento\Sales\Api\Data\OrderInterface">
        <attribute code="payment_fee" type="float"/>
        <attribute code="base_payment_fee" type="float"/>
        <attribute code="payment_fee_tax" type="float"/>
        <attribute code="base_payment_fee_tax" type="float"/>
    </extension_attributes>
    <extension_attributes for="Magento\Sales\Api\Data\InvoiceInterface">
        <attribute code="payment_fee" type="float"/>
        <attribute code="base_payment_fee" type="float"/>
        <attribute code="payment_fee_tax" type="float"/>
        <attribute code="base_payment_fee_tax" type="float"/>
    </extension_attributes>
    <extension_attributes for="Magento\Sales\Api\Data\CreditmemoInterface">
        <attribute code="payment_fee" type="float"/>
        <attribute code="base_payment_fee" type="float"/>
        <attribute code="payment_fee_tax" type="float"/>
        <attribute code="base_payment_fee_tax" type="float"/>
    </extension_attributes>
    <!-- POST /V1/order/:orderId/refund and /V1/invoice/:invoiceId/refund: base fee amount to refund, excl. tax -->
    <extension_attributes for="Magento\Sales\Api\Data\CreditmemoCreationArgumentsInterface">
        <attribute code="payment_fee" type="float"/>
    </extension_attributes>
</config>
